# ===========================
#  C++ / Qt Creator
# ===========================

# Dossiers de build (Qt Creator crée build-<projet>-<kit>-Debug, etc.)
build/
build-*/
*-build-*/
debug/
release/
Debug/
Release/
cmake-build-*/

# Fichiers utilisateur Qt Creator (propres à chaque machine)
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
CMakeLists.txt.user
CMakeLists.txt.user.*
*.autosave
.qtc_clangd/
.qtcreator/

# Fichiers générés par qmake / moc / uic / rcc
Makefile
Makefile.*
.qmake.stash
.qmake.cache
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.moc
object_script.*.Release
object_script.*.Debug

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Objets et binaires compilés
*.o
*.obj
*.so
*.so.*
*.dll
*.dylib
*.a
*.lib
*.exe
*.out
*.app
*.pdb
*.ilk

